# ===== 必填：搜索 API（二选一）=====
# NewsAPI.org 免费 100次/天，注册地址: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# 备选：Bing Web Search API，Azure 免费 1000次/月
BING_SEARCH_API_KEY=your_bing_api_key_here

# ===== 必填：Anthropic API =====
# 注册地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== 必填：QQ邮箱配置 =====
# QQ邮箱授权码获取: QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
QQ_EMAIL_SENDER=your_qq_email@qq.com
QQ_EMAIL_PASSWORD=your_qq_authorization_code
QQ_EMAIL_RECEIVER=receiver_email@qq.com

# ===== 可选 =====
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
